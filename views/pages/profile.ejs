<body class="light-theme" id="body" style="padding-top: 60px;">

  <!-- Toastify css cdn -->
  <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css" />

  <!-- Tailwind css cdn  -->
  <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <style>
    .circular-progress {
        --size: 30px;
        --half-size: calc(var(--size) / 2);
        --stroke-width: 20px;
        --radius: calc((var(--size) - var(--stroke-width)) / 2);
        --circumference: calc(var(--radius) * pi * 2);
        --dash: calc((var(--progress) * var(--circumference)) / 100);
        animation: progress-animation 5s linear 0s 1 forwards;
    }

    .circular-progress circle {
        cx: var(--half-size);
        cy: var(--half-size);
        r: var(--radius);
        stroke-width: var(--stroke-width);
        fill: none;
        stroke-linecap: round;
    }

    .circular-progress circle.bg {
        stroke: #ddd;
    }

    .circular-progress circle.fg {
        transform: rotate(-90deg);
        transform-origin: var(--half-size) var(--half-size);
        stroke-dasharray: var(--dash) calc(var(--circumference) - var(--dash));
        transition: stroke-dasharray 0.3s linear 0s;
        stroke: #e01c8f;
    }

    @property --progress {
        syntax: "<number>";
        inherits: false;
        initial-value: 0;
    }

    @keyframes progress-animation {
        from {
            --progress: 0;
        }

        to {
            --progress: 80;
        }
    }

    .circular-progress {
        --size: 250px;
        --half-size: calc(var(--size) / 2);
        --stroke-width: 20px;
        --radius: calc((var(--size) - var(--stroke-width)) / 2);
        --circumference: calc(var(--radius) * pi * 2);
        --dash: calc((var(--progress) * var(--circumference)) / 100);
        animation: progress-animation 2s linear 0s 1 forwards;
    }

    .circular-progress circle {
        cx: var(--half-size);
        cy: var(--half-size);
        r: var(--radius);
        stroke-width: var(--stroke-width);
        fill: none;
        stroke-linecap: round;
    }

    .circular-progress circle.bg {
        stroke: #ddd;
    }

    .circular-progress circle.fg {
        transform: rotate(-90deg);
        transform-origin: var(--half-size) var(--half-size);
        stroke-dasharray: var(--dash) calc(var(--circumference) - var(--dash));
        transition: stroke-dasharray 0.3s linear 0s;
        stroke: #e01c8f;
    }
</style>
  <body>

    <div class="desktop-message">
      <div class="card">This site is best viewed on a mobile device.</div>
    </div>


    <div class="content" style="max-height: calc(90vh - 60px); overflow-y: auto; margin-top: 20px;">
      <% if (typeof user=='undefined' ) { %>
        <div class="sidebar flex fixed w-full" style="z-index: 100;">
          <a href="/profile"> <img class="w-12 rounded-full" src="/images/avatar.jpg" alt=""></i></a>
          <div class="fixed top-2 right-4 z-50">
            <button id="theme-toggle" class="bg-blue-600 text-white p-2 rounded"> <i class="fas fa-moon"></i> </button>
          </div>
        </div>
      <% } %>

      <% if (typeof user !=='undefined' ) { %>
        <%- include('../includes/sidebar') %>
      <% } %>


      <% if (typeof user=='undefined' ) { %>
        <div class="bg-[#ffb3f3] h-screen flex items-center justify-center w-full">
          <img class="w-full h-1/2 absolute top-0 z-10 rounded-br-[6rem] rounded-bl-[6rem]"
            src="/images/profile/profile-top.png" alt="Profile image">
          
          <!------------------------------- user-signup--------------------------- -->
          <form id="signupForm" method="post" class="bg-white shadow-lg rounded-lg p-8 w-[80%] max-w-md z-10" style="margin-top: 20px;">
            <h2 class="text-2xl font-semibold text-center mb-2">Sign Up</h2>
            <p class="text-center text-sm text-green-600 mb-4">
              Already have account
              <a href="#" class="underline" style="color: #0000ee" onclick="toggleForm()">Sign In</a>
            </p>

            <!-- Username Input -->
            <div class="mb-4">
              <label for="username" class="block text-gray-700 font-semibold mb-2">Username</label>
              <input type="text" id="username" name="username"
                class="w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 transition-shadow duration-200"
                placeholder="Enter your username" />
            </div>

            <!-- Password Input -->
            <div class="mb-4">
              <label for="password" class="block text-gray-700 font-semibold mb-2">Password</label>
              <input type="password" id="password" name="password"
                class="w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 transition-shadow duration-200"
                placeholder="Enter your password" />
            </div>

            <!-- Date of Birth Input -->
            <div class="mb-4">
              <label for="dob" class="block text-gray-700 font-semibold mb-2">Date of Birth</label>
              <div class="relative" onclick="document.getElementById('dob').showPicker()">
                <input type="date" id="dob" name="dob"
                  class="w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 transition-shadow duration-200"
                  placeholder="Enter your date of birth" />
              </div>
            </div>
            
            

            <!-- Gender Input -->
            <div class="mb-4">
              <label for="gender" class="block text-gray-700 font-semibold mb-2">Gender</label>
              <select id="gender" name="gender"
                class="w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 transition-shadow duration-200">
                <option value="" disabled selected>Select your gender</option>
                <option value="male">Male</option>
                <option value="female">Female</option>
                <option value="other">Other</option>
              </select>
            </div>

            <!-- Full Name Input -->
            <div class="mb-4">
              <label for="fullName" class="block text-gray-700 font-semibold mb-2">Full Name</label>
              <input type="text" id="fullName" name="fullName"
                class="w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 transition-shadow duration-200"
                placeholder="Enter your full name" />
            </div>

            <!-- Phone Number Input -->
            <div class="mb-4">
              <label for="phoneNumber" class="block text-gray-700 font-semibold mb-2">Phone Number</label>
              <input type="tel" id="phoneNumber" name="phoneNumber"
                class="w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 transition-shadow duration-200"
                placeholder="Enter your phone number" />
            </div>

            <!-- Submit Button -->
            <button type="submit"
              class="w-full bg-[#7C3AED] text-white py-3 rounded-lg font-semibold hover:ring-opacity-80 active:bg-[#4C1D95] hover:shadow-lg transition-all duration-300 focus:ring-4 focus:ring-purple-300 focus:ring-opacity-50">
              Submit
            </button>
          </form>

          <!------------------------------- user-signin--------------------------- -->
          <form id="signInForm" method="post" class="bg-white shadow-lg rounded-lg p-8 w-[80%] max-w-md z-10"
            style="display: none">

            <h2 class="text-2xl font-semibold text-center mb-2">Sign In</h2>
            <p class="text-center text-sm text-green-600 mb-4">
              Don't have account
              <a href="#" class="underline" style="color: #0000ee" onclick="toggleForm()">SignUp</a>
            </p>

            <!-- Username Input -->

            <div class="mb-4">
              <label for="signIn-username" class="block text-gray-700 font-medium mb-2">Enter
                Username:</label>
              <input type="text" id="signIn-username" name="username"
                class="w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 transition-shadow duration-200"
                placeholder="Enter your username" />
            </div>

            <!-- Password Input -->
            <div class="mb-4">
              <label for="signIn-password" class="block text-gray-700 font-medium mb-2">Enter
                Password:</label>
              <input type="password" id="signIn-password" name="password"
                class="w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 transition-shadow duration-200"
                placeholder="Enter your password" />
            </div>

            <!-- Submit Button -->
            <button type="submit"
              class="w-full bg-[#7C3AED] text-white py-3 rounded-lg font-semibold hover:ring-opacity-80 active:bg-[#4C1D95] hover:shadow-lg transition-all duration-300 focus:ring-4 focus:ring-purple-300 focus:ring-opacity-50">
              Submit
            </button>
          </form>
        </div>
      <% } %>

      <% if (typeof user !=='undefined' ) { %>
        <div class="h-screen bg-[#ffb3f3] w-full flex flex-col items-center justify-center">
          <img class="w-full h-1/2 absolute top-0 z-10 rounded-br-[6rem] rounded-bl-[6rem]"
              src="/images/profile/profile-top.png" alt="Profile image">

          <div class="flex z-20 flex-col w-full items-center justify-center absolute bottom-[18%] gap-5">
              <img class="relative w-24 h-24 rounded-full" src="/images/avatar.jpg" alt="">

              <div class="bg-white rounded-2xl relative p-2 w-1/2 text-center">
                  <span id="user-info"><%= user.username %></span>
              </div>

              <div class="bg-white w-4/5 py-4 border-2 rounded-3xl">

                  <div class="flex justify-center items-center flex-col">
                      <span class="py-1 font-semibold"> 250 points</span>
                      <span class="text-gray-500 text-sm">+20 Since Last Week</span>
                  </div>

                  <div class="flex items-center justify-center my-3">
                    <svg width="100" height="100" viewBox="0 0 250 250" class="circular-progress">
                        <circle class="bg"></circle>
                        <circle class="fg"></circle>
                        <text x="50%" y="50%" dominant-baseline="middle" text-anchor="middle" fill="#e01c8f"
                            font-size="45" font-weight="bold">
                            80%
                        </text>
                    </svg>
                </div>
                  <div class="text-center text-sm px-3 w-full text-gray-500">You explored 80% of the self-help resource!
                      Keep Pushing :)</div>

                  <div class="flex flex-col px-3 py-3 w-full">
                      <span class="py-1 ">
                          <i class="fa-solid fa-calendar-days text-[1.6rem]"></i>
                          <span class="pl-4">Joined on <%= user.createdAt.toDateString() %></span>
                      </span>
                      <span class="py-1 ">
                          <i class="fa-solid fa-user text-[1.6rem]"></i>
                          <span class="pl-4">Full Name: <%= user.fullName %></span>
                      </span>
                      <span class="py-1 ">
                          <i class="fa-solid fa-calendar text-[1.6rem]"></i>
                          <span class="pl-4">Age: <%= user.age %></span>
                      </span>
                      <span >
                          <i class="fa-solid fa-venus-mars text-[1.6rem]"></i>
                          <span class="pl-2">Gender: <%= user.gender %></span>
                      </span>
                  </div>

              </div>
          </div>
      </div>
      <% } %>

      <%- include('../includes/navbar') %>

      <!-- handeling form data -->
      <script src="/js/auth.js"></script>
      <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
                          
    </div>
  </body>

</html>
